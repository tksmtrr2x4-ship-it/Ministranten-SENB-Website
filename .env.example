# Alle Werte in Vercel als Umgebungsvariablen setzen (Project Settings → Environment Variables),
# nicht in eine .env-Datei im Repo committen.

# MongoDB – EU-Region wählen (z. B. MongoDB Atlas Frankfurt), AV-Vertrag nach KDG abschließen.
MONGODB_URI=
MONGODB_DB=minis_db

# SMTP – Plattform: Gmail. Host/Port/Secure sind in lib/mailer.js bereits
# auf Gmail voreingestellt (smtp.gmail.com:465), hier stehen sie nur zur
# Kontrolle/zum Überschreiben. Nötig ist nur SMTP_USER + SMTP_PASS:
#   1. In diesem Gmail-Konto die 2-Faktor-Authentifizierung aktivieren
#      (ohne 2FA gibt es kein App-Passwort, und das normale Passwort
#      funktioniert nicht für SMTP-Login).
#   2. App-Passwort erzeugen: myaccount.google.com/apppasswords
#   3. SMTP_USER = die volle Gmail-Adresse, SMTP_PASS = das 16-stellige App-Passwort.
# Hinweis KDG/Datenschutz: Ein privates Gmail-Konto hat keinen AV-Vertrag –
# nur Google Workspace (kostenpflichtig) bietet einen. Für den Produktivbetrieb
# mit echten Kinderdaten vorher klären, ob das für die Kirchengemeinde reicht,
# oder auf Workspace/einen anderen Anbieter mit AV-Vertrag wechseln.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FALLBACK_EMAIL=

# Ansprechpersonen je Gemeinde (siehe lib/gemeinden.js) – reale Adressen eintragen.
KONTAKT_ST_FRANZISKUS=
KONTAKT_MARIA_HIMMELFAHRT=
KONTAKT_ST_GEORG=
KONTAKT_ST_ANNA=
KONTAKT_ST_OTMAR=

# Interner Bereich (/intern) – Admin-Login.
# ADMIN_PASSWORD_HASH wird lokal erzeugt mit:
#   node -e "import('./lib/password.js').then(m => console.log(m.hashPassword('DEIN_PASSWORT')))"
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Zufälliger, langer String zum Signieren der Session-Cookies/JWTs.
JWT_SECRET=

# Geheimer Header-Wert, den Vercel Cron beim Aufruf von /api/cron/cleanup mitschicken muss.
CRON_SECRET=
